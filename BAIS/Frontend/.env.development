# Local development — loaded automatically by `npm run dev` (Vite mode=development).
# Relative base => requests go same-origin to the Vite dev server (localhost:5173),
# which proxies /api and /socket.io to http://localhost:7000. No cross-origin request,
# so CORS never engages. Do not put an absolute URL here.
VITE_API_URL=/api

# Admin (INSZoom) portal used for cross-portal redirects in dev.
VITE_INSZOOM_URL=http://localhost:3002
