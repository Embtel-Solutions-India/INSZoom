NODE_ENV=development
PORT=7000
DEBUG_ERRORS=false
EXPOSE_INTERNAL_ERRORS=false

MONGODB_URI=your_mongodb_connection_string_here

CLIENT_URL=https://client.immiglance.com
CLIENT_URLS=https://immiglance.com,https://client.immiglance.com,https://admin.immiglance.com,https://attorney.immiglance.com,http://localhost:3002,http://localhost:5173,http://localhost:5174,http://localhost:5175
ATTORNEY_PORTAL_URL=https://attorney.immiglance.com
ADMIN_PORTAL_URL=https://admin.immiglance.com
LANDING_URL=https://immiglance.com

JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_E cheXPIRES=7d
JWT_REFRESH_EXPIRES=7d
REFRESH_TOKEN_TTL_DAYS=7

# =========================================================
# GOOGLE DOCUMENT AI
# =========================================================a
DOCUMENT_INTELLIGENCE_PROVIDER=your_document_intelligence_provider_here
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id_here
GOOGLE_CLOUD_LOCATION=your_google_cloud_location_here
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=your_google_document_ai_processor_id_here
GOOGLE_SERVICE_ACCOUNT_TYPE=service_account
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=your_google_service_account_project_id_here
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_ID=your_google_service_account_private_key_id_here
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=your_google_service_account_private_key_here
GOOGLE_SERVICE_ACCOUNT_CLIENT_ID= your_google_service_account_client_id_here
GOOGLE_SERVICE_ACCOUNT_AUTH_URI=your_google_service_account_auth_uri_here
GOOGLE_SERVICE_ACCOUNT_TOKEN_URI=your_google_service_account_token_uri_here
GOOGLE_SERVICE_ACCOUNT_AUTH_PROVIDER_CERT_URL=your_google_service_account_auth_provider_cert_url_here
GOOGLE_SERVICE_ACCOUNT_CLIENT_CERT_URL=your_google_service_account_client_cert_url_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=your_google_oauth_redirect_uri_here
GOOGLE_DRIVE_SCOPES=your_google_drive_scopes_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here
FIREBASE_PRIVATE_KEY_ID=your_firebase_private_key_id_here
FIREBASE_PRIVATE_KEY=your_firebase_private_key_here
FIREBASE_CLIENT_ID=your_firebase_client_id_here

DEBUG_ERRORS=true
EXPOSE_INTERNAL_ERRORS=false

STORAGE_PROVIDER=your_storage_provider_here
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=your_aws_region_here
AWS_S3_BUCKET=your_aws_s3_bucket_here
STORAGE_ENCRYPTION_KEY=your_storage_encryption_key_here

ADOBE_PDF_SERVICES_CLIENT_ID=your_adobe_pdf_services_client_id_here
ADOBE_PDF_SERVICES_CLIENT_SECRET=your_adobe_pdf_services_client_secret_here
# Adobe PDF Services is currently failing on essentially every real request
# (verified directly against Adobe's own API, bypassing this app's code
# entirely - "INTERNAL_SERVER_ERROR" even with zero form fields, on a raw,
# unmodified template buffer) - not the documented ~50% transient flakiness,
# closer to 100% right now. This is the app's own documented, intended
# manual kill-switch for exactly this situation (see env.js's adobe.fillEnabled
# comment) - flipped off so downloads work via the pdf-lib engine
# (PDFRenderer.js) instead of hard-failing on every attempt. Flip back to
# true (or remove this line) once Adobe's service recovers.
ADOBE_PDF_FILL_ENABLED=false

BCRYPT_ROUNDS=12
QPDF_PATH=your_qpdf_path_here

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=209715200

GEMINI_MODEL=gemini-flash-latest
GEMINI_API_KEY=your_gemini_api_key_here

# Email (SMTP) - leave blank to disable outbound email; sends will be logged
# to EmailLog with status "skipped" instead of failing.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
EMAIL_FROM="Immiglance <info@immiglance.com>"

STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# On-demand USCIS form acquisition (OnDemandFormAcquisitionService) - auto-
# activate a freshly-fetched form edition immediately (true) vs. leave it as
# a draft awaiting an admin's manual activation (false/unset). true is safe
# for this internal, non-resale portal (no public self-service filing).
USCIS_ONDEMAND_AUTOACTIVATE=true

#GHL Keys
GHL_PRIVATE_INTEGRATION_TOKEN=your_ghl_private_integration_token_here
GHL_LOCATION_ID=your_ghl_location_id_here
# GHL pipelines + webhook (IDs from the GHL location; public key is GHL official, not ours)
GHL_IMMIGRANT_PIPELINE_ID=your_ghl_immigrant_pipeline_id_here
GHL_NON_IMMIGRANT_PIPELINE_ID=your_ghl_non_immigrant_pipeline_id_here
GHL_WEBHOOK_PUBLIC_URL=your_ghl_webhook_public_url_here
GHL_WEBHOOK_PUBLIC_KEY=your_ghl_webhook_public_key_here
GHL_ENABLED=true
# A card deleted in GHL deletes its case here (2-step confirmed, see integrations/ghl/ghlDeletedInGhl.js)
GHL_DELETE_CASES_REMOVED_IN_GHL=true

# New cases that name no team lead go to this active team lead (case.service.js resolveTeamLeadForCase).
DEFAULT_TEAM_LEAD_EMAIL=your_default_team_lead_email_here

# Cases created by admin@immiglance.com get teamlead@immiglance.com as their team lead (creatorEmail=teamLeadEmail, comma separated).
TEAM_LEAD_BY_CREATOR_EMAIL=your_admin_email_here=your_team_lead_email_here
# Form edition policy: the system checks USCIS pages itself (at activation attempts and after each 12-hour catalog sync) and records accepted / not_accepted only on an explicit USCIS statement
FORM_EDITION_AUTO_EVIDENCE=true

# Master email switch: true = NO outbound email to anyone (team, attorneys, clients); every one is logged as skipped. Remove or set false to send again.
EMAIL_SUPPRESS_ALL=false

# Master notification switch: true = NO in-app notifications and NO browser push for anyone (nothing is stored while on). Remove or set false to resume.
NOTIFICATIONS_SUPPRESS_ALL=false
# Phase 4: Gemini field mapping. on = suggestions are stored and AI mappings are applied ONLY when the accuracy gate is open (it is closed until an evaluation meets the plan's thresholds)
FORM_AI_MAPPING=on
# Phase 7.E: forms still stuck after every automatic attempt are e-mailed to the developer (one e-mail for all, daily reminder while stuck)
DEVELOPER_EMAIL=your_developer_email_here
FORM_PIPELINE_EMAIL_STUCK=true
FORM_PIPELINE_STUCK_REMINDER_HOURS=24

# Addresses that never receive any email from the system (comma separated). Unset = madaan@bayareaimmigrationservices.com is blocked; empty = block nobody.
EMAIL_BLOCKED_RECIPIENTS=your_blocked_email1_here,your_blocked_email2_here
FORM_PIPELINE_AUTONOMY=on