NODE_ENV=development
PORT=7000
DEBUG_ERRORS=false
EXPOSE_INTERNAL_ERRORS=false

# Escape hatch for `npm run seed*` (Backend/src/seeds/*) when NODE_ENV=production.
# Those scripts create demo users/clients/cases with known passwords - leave unset.
# ALLOW_DEMO_SEED=true

MONGODB_URI=your_mongodb_connection_string
CLIENT_URLS=http://localhost:5173, http://localhost:3002
CLIENT_URL=http://localhost:5173
# Landing's own origin - used where a link must go to Landing specifically
# (e.g. consultation booking/management, a pre-auth flow) regardless of
# CLIENT_URLS/CLIENT_URL, which point at the Client portal.
LANDING_URL=http://localhost:5173
ATTORNEY_PORTAL_URL=http://localhost:5174

JWT_ACCESS_SECRET=your_that_secret_key_here
JWT_REFRESH_SECRET=your_that_secret_key_here
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=7d
REFRESH_TOKEN_TTL_DAYS=7

# =========================================================
# GOOGLE OAUTH (Client Portal "Continue with Google" login)
# =========================================================
# Web Client OAuth credentials from Google Cloud Console. Client secret is
# read on the backend only — never sent to the frontend, never logged.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_that_secret_key_here
# Must exactly match a redirect URI registered on the OAuth Client in Google
# Cloud Console. Backend route: GET /api/auth/google/callback.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:7000/api/auth/google/callback

# =========================================================
# GOOGLE DOCUMENT AI
# =========================================================
DOCUMENT_INTELLIGENCE_PROVIDER=google_document_ai
GEMINI_MODEL=gemini-flash-latest
GOOGLE_CLOUD_PROJECT_ID=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=YOUR_PROCESSOR_LOCATION
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=YOUR_PROCESSOR_ID
GOOGLE_SERVICE_ACCOUNT_TYPE=your_service_account_type
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=your_service_account_project_id
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_ID=your_service_account_private_key_id
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=your_service_account_private_key
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=your_service_account_client_email
GOOGLE_SERVICE_ACCOUNT_CLIENT_ID=your_service_account_client_id
GOOGLE_SERVICE_ACCOUNT_AUTH_URI=your_service_account_auth_uri
GOOGLE_SERVICE_ACCOUNT_TOKEN_URI=your_service_account_token_uri
GOOGLE_SERVICE_ACCOUNT_AUTH_PROVIDER_CERT_URL=your_service_account_auth_provider_cert_url
GOOGLE_SERVICE_ACCOUNT_CLIENT_CERT_URL=your_service_account_client_cert_url
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY_ID=your_firebase_private_key_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_ID=your_firebase_client_id

AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_that_secret_key_here
AWS_REGION=your_region
AWS_S3_BUCKET=your_bucket_name
STORAGE_PROVIDER=local
STORAGE_ENCRYPTION_KEY=your_that_secret_key_here

ADOBE_PDF_SERVICES_CLIENT_ID=your_client_id
ADOBE_PDF_SERVICES_CLIENT_SECRET=your_client_secret

BCRYPT_ROUNDS=12
QPDF_PATH=your_qpdf_executable_path

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=209715200

GEMINI_API_KEY=your_gemini_api_key
# Email (SMTP) - leave blank to disable outbound email; sends will be logged
# to EmailLog with status "skipped" instead of failing.
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_that_secret_key_here
EMAIL_FROM="Immiglance <no-reply@immiglance.com>"

STRIPE_SECRET_KEY=your_that_secret_key_here
STRIPE_WEBHOOK_SECRET=your_that_secret_key_here

# On-demand USCIS form acquisition (OnDemandFormAcquisitionService) - auto-
# activate a freshly-fetched form edition immediately (true) vs. leave it as
# a draft awaiting an admin's manual activation (false/unset).
USCIS_ONDEMAND_AUTOACTIVATE=false
# Retry tuning for downloading a form's official PDF from uscis.gov - both
# already default sensibly (3 attempts / 500ms base backoff) if left unset.
# USCIS_PDF_DOWNLOAD_MAX_ATTEMPTS=3
# USCIS_PDF_DOWNLOAD_RETRY_DELAY_MS=500


#GHL Keys
GHL_PRIVATE_INTEGRATION_TOKEN=your_that_secret_key_here
GHL_LOCATION_ID=your_ghl_location_id
GHL_PIPELINE_ID=your_ghl_pipeline_id

# GHL integration (off unless GHL_ENABLED=true; every GHL route then returns 503 and no worker starts)
# GHL_ENABLED=false

# GHL REST API (the Private Integration token + location are set under "GHL Keys" above).
# GHL_API_BASE_URL=https://services.leadconnectorhq.com
# GHL_API_VERSION=2021-07-28

# The two documentation pipelines that form the unified board. Find the IDs in GHL
# (Opportunities > Pipelines) or via GET /opportunities/pipelines?locationId=<GHL_LOCATION_ID>.
# If an ID is left blank, that pipeline is matched by its exact name below instead.
# GHL_IMMIGRANT_PIPELINE_ID=<id of "Immigrant Documentation pipeline">
# GHL_NON_IMMIGRANT_PIPELINE_ID=<id of "Non-Immigrant Documentation pipeline">
# GHL_IMMIGRANT_PIPELINE_NAME=Immigrant Documentation pipeline
# GHL_NON_IMMIGRANT_PIPELINE_NAME=Non-Immigrant Documentation pipeline

# Inbound webhooks. Configure this URL in GHL (Marketplace app > Webhooks). Informational here.
# GHL_WEBHOOK_PUBLIC_URL=https://<your-api-domain>/api/integrations/ghl/webhooks
# GHL's OFFICIAL Ed25519 PUBLIC key, used to verify the X-GHL-Signature header against the raw
# request body. Copy it from GHL's "Webhook Integration Guide"
# (marketplace.gohighlevel.com/docs/webhook/WebhookIntegrationGuide). Accepts the PEM block or the
# bare base64 key. It is GHL's key, NOT ours: never generate or commit a private key for this.
# Webhooks are rejected until it is set.
# GHL_WEBHOOK_PUBLIC_KEY=
# Reject webhooks whose timestamp is older than this many seconds (default 86400). Duplicates are
# already blocked by webhookId; this is only a coarse replay bound.
# GHL_WEBHOOK_TOLERANCE_SECONDS=86400

# The bulk "Sync now" import never emails clients/team leads unless this is true (default false).
# GHL_IMPORT_SENDS_EMAILS=false
