NODE_ENV=development
PORT=7000

MONGODB_URI=your_mongodb_connection_string
CLIENT_URLS=http://localhost:5173, http://localhost:3002
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=bais_access_super_secret_key_2026_do_not_share
JWT_REFRESH_SECRET=bais_refresh_super_secret_key_2026_do_not_share
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=7d
REFRESH_TOKEN_TTL_DAYS=7

BCRYPT_ROUNDS=12
QPDF_PATH=your_qpdf_executable_path

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

GEMINI_API_KEY=your_gemini_api_key
# Email (SMTP) - leave blank to disable outbound email; sends will be logged
# to EmailLog with status "skipped" instead of failing.
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM=no-reply@usareaimmigrationservices.com

STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

FIREBASE_PROJECT_ID=your_firebase_project_id
# Required for firebase-admin to send Cloud Messaging (browser push) and to
# verify Google sign-in with real credentials instead of falling back to
# Application Default Credentials. From the service account JSON: "client_email"
# and "private_key" (keep the \n escapes in the private key when pasting).
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_client_email
FIREBASE_PRIVATE_KEY="your_firebase_service_account_private_key"