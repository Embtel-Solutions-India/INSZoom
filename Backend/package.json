{
  "name": "immigration-crm-backend",
  "version": "1.0.0",
  "description": "Shared backend for BAIS Client Portal and INSZoom Admin CRM",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "check": "node --check src/server.js",
    "test": "node --test \"src/**/*.test.js\"",
    "seed:users": "node src/seeds/seedUsers.js",
    "seed:clients": "node src/seeds/seedClients.js",
    "seed:cases": "node src/seeds/seedCases.js",
    "seed": "node src/seeds/index.js",
    "backfill:family-checklist-references": "node src/scripts/backfillFamilyChecklistReferences.js",
    "migrate:case-participants": "node src/scripts/migrateCaseParticipants.js",
    "migrate:package-names": "node src/scripts/migratePackageNames.js",
    "indexes:case-list": "node src/scripts/createCaseListIndexes.js",
    "seed:package-definitions": "node src/modules/petition/seeds/packageDefinitions.seed.js",
    "seed:i129": "node src/modules/uscis-form-import/seeds/i129.seed.js",
    "seed:i129f": "node src/modules/uscis-form-import/seeds/i129f.seed.js",
    "seed:i130": "node src/modules/uscis-form-import/seeds/i130.seed.js",
    "seed:i134": "node src/modules/uscis-form-import/seeds/i134.seed.js",
    "seed:i539": "node src/modules/uscis-form-import/seeds/i539.seed.js",
    "seed:i539a": "node src/modules/uscis-form-import/seeds/i539a.seed.js",
    "seed:i907": "node src/modules/uscis-form-import/seeds/i907.seed.js",
    "seed:uscis-forms": "node -e \"const mongoose=require('mongoose'); const env=require('./src/config/env'); const r=require; mongoose.connect(env.mongoUri).then(()=>['i129','i129f','i130','i134','i539','i539a','i907'].reduce((p,n)=>p.then(()=>r('./src/modules/uscis-form-import/seeds/'+n+'.seed')()), Promise.resolve())).then(()=>mongoose.disconnect()).catch(async e=>{console.error(e.message); await mongoose.disconnect().catch(()=>{}); process.exit(1);})\"",
    "seed:i129-mapping": "node src/modules/form-mapping/seeds/i129-h1b-mapping.seed.js",
    "seed:i129f-k1-mapping": "node src/modules/form-mapping/seeds/i129f-k1-mapping.seed.js",
    "seed:i130-k3-mapping": "node src/modules/form-mapping/seeds/i130-k3-mapping.seed.js",
    "import:form": "node src/modules/uscis-form-import/scripts/importLocalForm.js",
    "test:e2e": "node --test \"src/modules/h1b-e2e/tests/*.test.js\"",
    "phase0:capture-golden": "node src/scripts/phase0CaptureGolden.js",
    "phase0:verify": "node src/scripts/phase0Verify.js",
    "test:phase0-golden": "node --test src/modules/form-generation/tests/phase0.golden.manual.js",
    "phase1:reconcile": "node src/scripts/phase1Reconcile.js",
    "phase1:verify": "node src/scripts/phase1Verify.js",
    "phase2:verify": "node src/scripts/phase2Verify.js",
    "phase3:verify": "node src/scripts/phase3Verify.js",
    "phase4:verify": "node src/scripts/phase4Verify.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@google-cloud/documentai": "^10.0.0",
    "@google/genai": "^2.10.0",
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.79.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "deep-diff": "^1.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "file-type": "^22.0.1",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^7.1.0",
    "html-to-docx": "^1.8.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.18.1",
    "mime-types": "^3.0.2",
    "mongodb": "^7.5.0",
    "mongoose": "^8.24.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.9.16",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.1.200",
    "socket.io": "^4.7.5",
    "stripe": "^16.12.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  }
}
