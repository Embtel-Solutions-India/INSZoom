><script contentType="application/x-javascript" runAt="both"
>if(this.rawValue == "USA") {
 S3_Line3_State.access = 'open';
 S3_Line3_ZipCode.access = 'open'; 
 S3_Line3_PostalCode.access = 'readOnly';
 S3_Line3_Province.access = 'readOnly';
 S3_Line3_PostalCode.rawValue = '';
 S3_Line3_Province.rawValue = '';
} else if((this.rawValue == null) || (this.rawValue == "")){ 
  S3_Line3_State.access = 'open';
  S3_Line3_ZipCode.access = 'open';
  S3_Line3_PostalCode.access = 'open';
  S3_Line3_Province.access = 'open';
  S3_Line3_PostalCode.rawValue = '';
  S3_Line3_Province.rawValue = '';
  S3_Line3_State.rawValue = '';
  S3_Line3_ZipCode.rawValue = '';
} else{
 //xfa.host.messageBox("["+this.rawValue+"]");
 S3_Line3_State.access = 'readOnly';
 S3_Line3_ZipCode.access = 'readOnly';
 S3_Line3_PostalCode.access = 'open';
 S3_Line3_Province.access = 'open';
}

</script
