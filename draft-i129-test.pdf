><script contentType="application/x-javascript" runAt="both"
>
if(this.rawValue == "USA") {
 A1_State.access = 'open';
 A1_ZipCode.access = 'open'; 
 A1_PostalCode.access = 'readOnly';
 A1_Province.access = 'readOnly';
 A1_PostalCode.rawValue = '';
 A1_Province.rawValue = '';
} else if((this.rawValue == null) || (this.rawValue == "")){ 
  A1_State.access = 'open';
  A1_ZipCode.access = 'open';
  A1_PostalCode.access = 'open';
  A1_Province.access = 'open';
  A1_PostalCode.rawValue = '';
  A1_Province.rawValue = '';
  A1_State.rawValue = '';
  A1_ZipCode.rawValue = '';
} else{
 //xfa.host.messageBox("["+this.rawValue+"]");
 A1_State.access = 'readOnly';
 A1_ZipCode.access = 'readOnly';
 A1_PostalCode.access = 'open';
 A1_Province.access = 'open';
}
</script
