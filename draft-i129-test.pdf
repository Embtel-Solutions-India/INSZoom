><draw x="14.817mm" y="59.267mm" w="182.033mm" h="8.761mm"
><font typeface="Times New Roman"
/><para vAlign="middle"
/><value
><exData contentType="text/html"
><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/"
><p style="letter-spacing:0in"
>See<span style="xfa-spacerun:yes"
>¬†</span
><a href="http://www.uscis.gov/h-2a" style="font-weight:bold"
>uscis.gov/h-2a</a
><span style="color:#ff0000"
><span style="xfa-spacerun:yes"
>¬†</span
></span
>and<span style="xfa-spacerun:yes"
>¬†</span
><a href="http://www.uscis.gov/h-2b" style="font-weight:bold"
>uscis.gov/h-2b</a
>, respectively, for the appropriate manner of notifying DHS as specified in a notice published in the Federal Register.</p
></body
></exData
></value
><ui
><textEdit
/></ui
><margin leftInset="0.5mm" rightInset="0.5mm" topInset="0.5mm" bottomInset="0.5mm"
