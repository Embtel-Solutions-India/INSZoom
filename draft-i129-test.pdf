><script contentType="application/x-javascript" runAt="both"
>// this checks if 5-digit Zip Code is entered
if(this.rawValue != null)
{
if (this.rawValue.length != 5)
{		
	xfa.host.messageBox("Please enter 5 digit Zip Code.");
	xfa.host.setFocus(this.somExpression);
	this.rawValue="";	
}
}

xfa.host.messageBox("Please visit https://tools.usps.com/go/ZipLookupAction_input to check that you have entered the full address as recognized by USPS, using standard abbreviations and formatting.", "", 3);
</script
></event
