>//Use to disable Postal Code, Province and Country
if ((this.rawValue!=" ") &amp;&amp; (this.rawValue!=null)) {
	S1_Line3_PostalCode.rawValue = null;
	S1_Line3_Province.rawValue = null;
	S1_Line3_Country.rawValue = null;
	S1_Line3_Province.access = "readOnly";
	S1_Line3_PostalCode.access = "readOnly";
	S1_Line3_Country.access = "readOnly";
	S1_Line3_Country.rawValue = "USA";
} else {
	S1_Line3_Province.access = "open";
	S1_Line3_PostalCode.access = "open";
	S1_Line3_Country.access = "open";
	S1_Line3_ZipCode.rawValue = "";
}	

</script
