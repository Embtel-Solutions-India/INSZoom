><script contentType="application/x-javascript" runAt="both"
>//Use to disable Postal Code, Province and Country
if ((this.rawValue!=" ") &amp;&amp; (this.rawValue!=null)) {
	FR_PostalCode.rawValue = null;
	FR_Province.rawValue = null;
	FR_Country.rawValue = null;
	FR_Province.access = "readOnly";
	FR_PostalCode.access = "readOnly";
	FR_Country.access = "readOnly";
	FR_Country.rawValue = "USA";
} else {
	FR_Province.access = "open";
	FR_PostalCode.access = "open";
	FR_Country.access = "open";
	FR_ZipCode.rawValue = "";
	FR_Country.rawValue = "";
}	

</script
></event
