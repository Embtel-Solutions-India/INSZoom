><script contentType="application/x-javascript" runAt="both"
>//Use to disable Postal Code, Province and Country
if ((this.rawValue!=" ") &amp;&amp; (this.rawValue!=null)) {
	Part3Line2_PostalCode.rawValue = null;
	Part3Line2_Province.rawValue = null;
	Part3Line2_Country.rawValue = null;
	Part3Line2_Province.access = "readOnly";
	Part3Line2_PostalCode.access = "readOnly";
	Part3Line2_Country.access = "readOnly";
	Part3Line2_Country.rawValue = "USA";
} else {
	Part3Line2_Province.access = "open";
	Part3Line2_PostalCode.access = "open";
	Part3Line2_Country.access = "open";

}	

</script
></event
><event activity="change" name="event__change"
><script contentType="application/x-javascript" runAt="both"
>//Use to disable Postal Code, Province and Country

if (xfa.event.newText!=" ") {
	Part3Line2_Province.access = "readOnly";
	Part3Line2_PostalCode.access = "readOnly";
	Part3Line2_Country.access = "readOnly";
	Part3Line2_Country.rawValue = "USA";
} else {
	Part3Line2_Province.access = "open";
	Part3Line2_PostalCode.access = "open";
	Part3Line2_Country.access = "open";
	Part3Line2_Country.rawValue = "";
}	
</script
></event
