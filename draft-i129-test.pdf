><script contentType="application/x-javascript" runAt="both"
>if(this.rawValue == "USA") {
 Line24_State.access = 'open';
 Line24_ZipCode.access = 'open'; 
 Line24_PostalCode.access = 'readOnly';
 Line24_Province.access = 'readOnly';
 Line24_PostalCode.rawValue = '';
 Line24_Province.rawValue = '';
} else if((this.rawValue == null) || (this.rawValue == "")){ 
  Line24_State.access = 'open';
  Line24_ZipCode.access = 'open';
  Line24_PostalCode.access = 'open';
  Line24_Province.access = 'open';
  Line24_PostalCode.rawValue = '';
  Line24_Province.rawValue = '';
  Line24_State.rawValue = '';
  Line24_ZipCode.rawValue = '';
} else{
 //xfa.host.messageBox("["+this.rawValue+"]");
 Line24_State.access = 'readOnly';
 Line24_ZipCode.access = 'readOnly';
 Line24_PostalCode.access = 'open';
 Line24_Province.access = 'open';
}

</script
