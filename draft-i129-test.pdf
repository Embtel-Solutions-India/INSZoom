><event activity="exit" name="event__exit"
><script contentType="application/x-javascript" runAt="both"
>
if(this.rawValue == "USA") {
 FR_State.access = 'open';
 FR_ZipCode.access = 'open'; 
 FR_PostalCode.access = 'readOnly';
 FR_Province.access = 'readOnly';
 FR_PostalCode.rawValue = '';
 FR_Province.rawValue = '';
} else if((this.rawValue == null) || (this.rawValue == "")){ 
  FR_State.access = 'open';
  FR_ZipCode.access = 'open';
  FR_PostalCode.access = 'open';
  FR_Province.access = 'open';
  FR_PostalCode.rawValue = '';
  FR_Province.rawValue = '';
  FR_State.rawValue = '';
  FR_ZipCode.rawValue = '';
} else{
 //xfa.host.messageBox("["+this.rawValue+"]");
 FR_State.access = 'readOnly';
 FR_ZipCode.access = 'readOnly';
 FR_PostalCode.access = 'open';
 FR_Province.access = 'open';
}

</script
></event
