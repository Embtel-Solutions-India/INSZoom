><event activity="change" name="event__change"
><script contentType="application/x-javascript" runAt="both"
>
// allows 0-9 
var regex = /[^0-9]/
if(regex.test(xfa.event.change)) {
  xfa.event.change = "";
  xfa.host.messageBox("Enter only numbers");
}
</script
></event
><event activity="exit" name="event__exit"
><script contentType="application/x-javascript" runAt="both"
>
// Social Security Num Validation on Exit
if(this.rawValue != null)
{
if (this.rawValue.length != 9)
{
	xfa.host.messageBox("Please enter 9 digit Social Security Number.");
	xfa.host.setFocus(this.somExpression);
	this.rawValue="";
}
}
</script
></event
