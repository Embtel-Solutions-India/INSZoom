><para vAlign="middle"
/><event activity="change" name="event__change"
><script contentType="application/x-javascript" runAt="both"
>
// allows -0-9, and /
var regex = /[^0-9\/]/
if(regex.test(xfa.event.change) || xfa.event.newText.length &gt; 10) {
  xfa.event.change = "";
  xfa.host.messageBox("Enter numeric and slash characters only.");
}
</script
></event
