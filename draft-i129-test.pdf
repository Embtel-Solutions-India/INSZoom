>//Use to disable Postal Code, Province and Country
if ((this.rawValue!=" ") &amp;&amp; (this.rawValue!=null)) {
	Line24_PostalCode.rawValue = null;
	Line24_Province.rawValue = null;
	Line24_Country.rawValue = null;
	Line24_Province.access = "readOnly";
	Line24_PostalCode.access = "readOnly";
	Line24_Country.access = "readOnly";
	Line24_Country.rawValue = "USA";
} else {
	Line24_Province.access = "open";
	Line24_PostalCode.access = "open";
	Line24_Country.access = "open";
	Line24_ZipCode.rawValue = "";
}	

</script
></event
