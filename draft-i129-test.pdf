><script contentType="application/x-javascript" runAt="both"
>if(this.rawValue == "USA") {
 P1_Line3_State.access = 'open';
 P1_Line3_ZipCode.access = 'open'; 
 P1_Line3_PostalCode.access = 'readOnly';
 P1_Line3_Province.access = 'readOnly';
 P1_Line3_PostalCode.rawValue = '';
 P1_Line3_Province.rawValue = '';
} else if((this.rawValue == null) || (this.rawValue == "")){ 
  P1_Line3_State.access = 'open';
  P1_Line3_ZipCode.access = 'open';
  P1_Line3_PostalCode.access = 'open';
  P1_Line3_Province.access = 'open';
  P1_Line3_PostalCode.rawValue = '';
  P1_Line3_Province.rawValue = '';
  P1_Line3_State.rawValue = '';
  P1_Line3_ZipCode.rawValue = '';
} else{
 //xfa.host.messageBox("["+this.rawValue+"]");
 P1_Line3_State.access = 'readOnly';
 P1_Line3_ZipCode.access = 'readOnly';
 P1_Line3_PostalCode.access = 'open';
 P1_Line3_Province.access = 'open';
}

</script
