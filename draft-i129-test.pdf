><script contentType="application/x-javascript" runAt="both"
>//Date Validation on Exit
if (this.rawValue == this.formattedValue)
{
	xfa.host.messageBox("Please enter 2 digit month, 2 digit day and 4 digit year.");
	xfa.host.setFocus(this.somExpression);
	this.rawValue="";
}
</script
