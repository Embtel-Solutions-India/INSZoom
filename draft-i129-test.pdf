><event activity="exit" name="event__exit"
><script contentType="application/x-javascript" runAt="both"
>//Use to disable Postal Code, Province and Country
if ((this.rawValue!=" ") &amp;&amp; (this.rawValue!=null)) {
	A1_PostalCode.rawValue = null;
	A1_Province.rawValue = null;
	A1_Country.rawValue = null;
	A1_Province.access = "readOnly";
	A1_PostalCode.access = "readOnly";
	A1_Country.access = "readOnly";
	A1_Country.rawValue = "USA";
} else {
	A1_Province.access = "open";
